<!--
  Messaging: the hand-written building block every service uses to talk through RabbitMQ safely. The
  transactional outbox (send only what was committed), the idempotent inbox (handle each message once),
  the dispatcher, the consumer host, the queue topology and the trace propagation. No service code and no
  knowledge of which messages exist. No MassTransit on purpose: the point is to see the mechanics.
  Guide: §8.4.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shop.Micro.Contracts\Shop.Micro.Contracts.csproj" />
  </ItemGroup>

</Project>
