    <ProjectReference Include="..\..\src\Shop.Micro.Catalog.Api\Shop.Micro.Catalog.Api.csproj" />
    <ProjectReference Include="..\..\src\Shop.Micro.Ordering.Api\Shop.Micro.Ordering.Api.csproj" />
    <ProjectReference Include="..\..\src\Shop.Micro.Payments.Api\Shop.Micro.Payments.Api.csproj" />
    <ProjectReference Include="..\..\src\Shop.Micro.Gateway\Shop.Micro.Gateway.csproj" />
  </ItemGroup>

</Project>
