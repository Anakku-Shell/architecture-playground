<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>

  <!-- Every deployable project, so the rules can load and read all the compiled assemblies. (The AppHost's
       own references do not copy the services' assemblies: it runs them, it does not link them.) -->
